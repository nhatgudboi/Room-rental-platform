// Database Markup Language (DBML 2.0)
// Project: Smart Room Rental Platform (Sàn Cho Thuê Phòng Trọ Thông Minh)
// Database Engine: PostgreSQL 16

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  phone_number varchar(20) [not null]
  avatar_url varchar(500)
  role user_role [not null, default: 'TENANT']
  kyc_status kyc_status [not null, default: 'UNVERIFIED']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    email [unique]
    phone_number
    role
    (is_active, deleted_at)
  }
}

Table landlord_kyc {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  id_card_number varchar(20) [not null]
  id_card_front_url varchar(500) [not null]
  id_card_back_url varchar(500) [not null]
  ownership_doc_url varchar(500) [not null]
  rejection_reason text
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    id_card_number
  }
}

Table districts {
  id int [pk, increment]
  name varchar(100) [not null]
  city varchar(100) [not null, default: 'Hà Nội']
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]

  Indexes {
    (name, city) [unique]
  }
}

Table university_landmarks {
  id int [pk, increment]
  name varchar(255) [not null]
  district_id int [not null, ref: > districts.id]
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]

  Indexes {
    name
    district_id
  }
}

Table rooms {
  id bigint [pk, increment]
  landlord_id bigint [not null, ref: > users.id]
  title varchar(255) [not null]
  description text [not null]
  address varchar(500) [not null]
  district_id int [not null, ref: > districts.id]
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  room_type room_type [not null, default: 'SINGLE_ROOM']
  area_sqm decimal(5,2) [not null]
  max_occupants smallint [not null, default: 2]
  monthly_rent decimal(12,2) [not null]
  deposit_required decimal(12,2) [not null]
  electricity_cost_kwh decimal(10,2) [not null]
  water_cost_m3 decimal(10,2) [not null]
  internet_cost_month decimal(10,2) [not null, default: 0]
  ai_predicted_price decimal(12,2)
  ai_price_min decimal(12,2)
  ai_price_max decimal(12,2)
  status room_status [not null, default: 'PENDING_APPROVAL']
  view_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    landlord_id
    district_id
    status
    monthly_rent
    area_sqm
    (latitude, longitude)
    (status, deleted_at)
  }
}

Table room_amenities {
  id bigint [pk, increment]
  room_id bigint [not null, unique, ref: - rooms.id]
  has_air_conditioner boolean [not null, default: false]
  has_water_heater boolean [not null, default: false]
  has_washing_machine boolean [not null, default: false]
  has_refrigerator boolean [not null, default: false]
  has_balcony boolean [not null, default: false]
  has_elevator boolean [not null, default: false]
  has_mezzanine boolean [not null, default: false]
  has_parking boolean [not null, default: true]
  is_free_hours boolean [not null, default: true]
  allows_pets boolean [not null, default: false]
  is_furnished boolean [not null, default: false]

  Indexes {
    room_id
  }
}

Table room_images {
  id bigint [pk, increment]
  room_id bigint [not null, ref: > rooms.id]
  image_url varchar(500) [not null]
  is_primary boolean [not null, default: false]
  display_order smallint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    room_id
    (room_id, is_primary)
  }
}

Table escrow_bookings {
  id bigint [pk, increment]
  booking_code varchar(32) [not null, unique]
  room_id bigint [not null, ref: > rooms.id]
  tenant_id bigint [not null, ref: > users.id]
  landlord_id bigint [not null, ref: > users.id]
  deposit_amount decimal(12,2) [not null]
  escrow_holding_deadline timestamptz [not null]
  checkin_appointment_date timestamptz [not null]
  status booking_status [not null, default: 'PENDING_PAYMENT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_code [unique]
    room_id
    tenant_id
    landlord_id
    status
    escrow_holding_deadline
  }
}

Table payments {
  id bigint [pk, increment]
  booking_id bigint [not null, ref: > escrow_bookings.id]
  transaction_ref varchar(100) [not null, unique]
  gateway varchar(50) [not null, default: 'VNPAY']
  payment_method payment_method [not null, default: 'VNPAY_QR']
  amount decimal(12,2) [not null]
  status payment_status [not null, default: 'PENDING']
  gateway_response text
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id
    transaction_ref [unique]
    status
  }
}

Table disputes {
  id bigint [pk, increment]
  booking_id bigint [not null, unique, ref: - escrow_bookings.id]
  complainant_id bigint [not null, ref: > users.id]
  reason varchar(255) [not null]
  description text [not null]
  evidence_urls text[]
  status dispute_status [not null, default: 'OPEN']
  resolution_notes text
  resolved_by bigint [ref: > users.id]
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id
    complainant_id
    status
  }
}

Table reviews {
  id bigint [pk, increment]
  booking_id bigint [not null, unique, ref: - escrow_bookings.id]
  room_id bigint [not null, ref: > rooms.id]
  tenant_id bigint [not null, ref: > users.id]
  overall_rating smallint [not null]
  rating_security smallint [not null]
  rating_cleanliness smallint [not null]
  rating_utilities smallint [not null]
  rating_landlord smallint [not null]
  comment text [not null]
  photo_urls text[]
  landlord_reply text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id
    room_id
    tenant_id
    overall_rating
  }
}

Table messages {
  id bigint [pk, increment]
  sender_id bigint [not null, ref: > users.id]
  receiver_id bigint [not null, ref: > users.id]
  room_id bigint [ref: > rooms.id]
  content text [not null]
  media_url varchar(500)
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (sender_id, receiver_id)
    room_id
    is_read
    created_at
  }
}

Table audit_logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  action varchar(50) [not null]
  entity_type varchar(50) [not null]
  entity_id bigint [not null]
  old_values jsonb
  new_values jsonb
  ip_address varchar(45)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    (entity_type, entity_id)
    action
    created_at
  }
}

// ==========================================
// ENUMS
// ==========================================

Enum user_role {
  ADMIN
  MODERATOR
  LANDLORD
  TENANT
}

Enum kyc_status {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

Enum room_type {
  STUDIO
  SINGLE_ROOM
  SHARED_ROOM
  APARTMENT
  HOMESTAY
}

Enum room_status {
  PENDING_APPROVAL
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  REJECTED
  FLAGGED_VIOLATION
}

Enum booking_status {
  PENDING_PAYMENT
  ESCROW_HOLDING
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

Enum payment_status {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

Enum payment_method {
  VNPAY_QR
  VNPAY_ATM
  VNPAY_CARD
  MOMO
}

Enum dispute_status {
  OPEN
  INVESTIGATING
  REFUND_APPROVED
  REFUND_REJECTED
  RESOLVED
}
